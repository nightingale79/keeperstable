# Copy this to ".env" for local runs, or set these as environment
# variables on your host. All are OPTIONAL — the app runs with sensible
# defaults if you set nothing.

# Port the server listens on (hosts usually set this for you).
PORT=3000

# Where the single data file (data.json) is stored. On a host with a
# persistent disk, point this at the mounted disk (e.g. /var/data) so
# your data survives restarts and redeploys.
# DATA_DIR=/var/data

# Secret used to sign login cookies. If you leave this unset, the app
# generates one and keeps it in the data directory. Set it explicitly
# (a long random string) if you prefer.
# SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when deployed (enables secure cookies).
# NODE_ENV=production
